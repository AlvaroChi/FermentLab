#encoding utf-8
#
# FL_CONTROLLER
#
DEF FL_CONTROLLER U 0 40 Y Y 1 F N
F0 "U" 0 750 50 H V C CNN
F1 "FL_CONTROLLER" 0 650 50 H V C CNN
DRAW
S -700 550 700 -550 0 1 12 f
X +3V3 1 -900 300 200 R 45 45 1 1 W
X GND 2 -900 150 200 R 45 45 1 1 W
X I2C_SDA 3 900 350 200 L 45 45 1 1 B
X I2C_SCL 4 900 200 200 L 45 45 1 1 B
X ONEWIRE 5 900 50 200 L 45 45 1 1 B
X RTC_INT_N 6 900 -100 200 L 45 45 1 1 I
X SD_CS 7 900 -250 200 L 45 45 1 1 O
X SD_MOSI 8 900 -400 200 L 45 45 1 1 O
X SD_MISO 9 -900 -300 200 R 45 45 1 1 I
X SD_SCK 10 -900 -450 200 R 45 45 1 1 O
ENDDRAW
ENDDEF
